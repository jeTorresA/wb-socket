NODE_ENV=development
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=gc
DATABASE_PASSWORD=avisgc
DATABASE_NAME=gc

# Pool de conexiones (por proceso). idleTimeout en ms: cierra conexiones idle.
DB_POOL_SIZE=10
DB_POOL_MAX_IDLE=4
DB_POOL_IDLE_TIMEOUT=60000

# Service-to-Service Authentication
# Token para autenticar backends internos que publican eventos
# Generar con: openssl rand -hex 32
SERVICE_AUTH_TOKEN=your-secure-token-here-change-in-production
# Emisores de JWT confiables (multiplataforma)
JWT_ISSUERS=[{"iss":"app-name","algo":"RS256","publicKey":"config/keys/app-name-public.pem","idClaim":"user.id_usuario","nameClaim":"user.nombre_usuario"}]